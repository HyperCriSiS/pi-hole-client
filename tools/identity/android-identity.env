# Canonical Android identity expected by the repository.
# Update these values only as part of a dedicated package/branding migration.
ANDROID_APPLICATION_ID='io.github.tsutsu3.pi_hole_client'
ANDROID_APP_LABEL='Pi-hole client'
ANDROID_RESOURCE_APP_NAME='Pi-hole'

# Space-separated IDs that must no longer occur in Android runtime/release wiring.
# After the independent-fork rename, put the previous application ID here.
ANDROID_FORBIDDEN_APPLICATION_IDS=''
